{
  "name": "jeri",
  "version": "1.0.0",
  "description": "Jeri – one email analysis, three ways to understand it (Listen, Captions, Easy Read). For people who cannot skim.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env server/index.js",
    "test": "node --test test/*.test.js",
    "core": "node scripts/core-gate.js",
    "core:local": "sh scripts/core-local.sh",
    "keyscan": "sh scripts/keyscan.sh",
    "deploy:cf": "node scripts/deploy-cloudflare.mjs",
    "dev:cf": "wrangler dev"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "axe-core": "^4.10.2",
    "playwright": "^1.63.0",
    "wrangler": "^4.45.0"
  }
}
