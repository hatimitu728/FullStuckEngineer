rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Analyses are written only by the server (Admin access bypasses these rules).
    match /analyses/{doc} { allow read, write: if false; }
    // Each signed-in user can read and write only their own drafts and approvals.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
