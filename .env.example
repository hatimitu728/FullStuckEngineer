# Copy to .env and fill in. Never commit .env.
# Gemini API key (Generative Language API). Used for analysis AND Gemini 3.8 Flash TTS.
# Optional: enable Cloud Text-to-Speech API on the same project for the fallback voice.
GEMINI_API_KEY=
# Optional: TTS engine: gemini (default, falls back to Cloud TTS) | cloud | gemini-only
TTS_ENGINE=
# Optional: Gemini TTS model/voice (defaults gemini-3.8-flash-tts / Sulafat)
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=
# Optional: separate key for Cloud TTS fallback (defaults to GEMINI_API_KEY)
TTS_API_KEY=
# Optional: model override (default gemini-2.5-flash, falls back to gemini-flash-latest)
GEMINI_MODEL=
# Optional: Firestore cache. Set to your Google Cloud project id to save analyses in Firestore.
FIRESTORE_PROJECT_ID=
# Optional: Firebase web config (public values, NOT secrets) to enable Google sign-in + Gmail (read-only).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
PORT=8080
