# Copy to .env and fill in. Never commit .env.
# One Google Cloud API key with "Generative Language API" and "Cloud Text-to-Speech API" enabled.
GEMINI_API_KEY=
# Optional: separate key for Cloud TTS (defaults to GEMINI_API_KEY)
TTS_API_KEY=
# Optional: model override (default gemini-2.5-flash, falls back to gemini-flash-latest)
GEMINI_MODEL=
# Optional: Firestore cache. Set to your Google Cloud project id to save analyses in Firestore.
FIRESTORE_PROJECT_ID=
# Optional: Firebase web config (public values, NOT secrets) to enable Google sign-in + Gmail (read-only).
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
PORT=8080
